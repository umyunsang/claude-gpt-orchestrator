{
  "description": "Inject one fixed language-agnostic CGO semantic routing contract into normal Claude Code prompts.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/cgo-router.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
